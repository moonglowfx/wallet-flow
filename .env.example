# Turso / libSQL Database Configuration (Vercel Marketplace / Turso CLI)
# When connecting Turso from Vercel Marketplace, TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are injected automatically.
# Local development defaults to file:wallet_flow.db when not set.

TURSO_DATABASE_URL="file:wallet_flow.db"
TURSO_AUTH_TOKEN=""

# Legacy / Alias variables also supported automatically:
DATABASE_URL="file:wallet_flow.db"
DATABASE_AUTH_TOKEN=""
