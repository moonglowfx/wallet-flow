# ==============================================================================
# Wallet Flow Database Configuration: SQLite (Local) & Turso Cloud (libSQL)
# ==============================================================================
# 
# 1. MODO LOCAL PERSISTENTE (Por defecto para desarrollo):
#    Guarda y preserva todos tus datos directamente en el archivo wallet_flow.db local.
#    TURSO_DATABASE_URL="file:wallet_flow.db"
#
# 2. MODO NUBE TURSO (Recomendado para Vercel o producción permanente):
#    Crea tu base de datos en https://turso.tech o con el CLI: turso db create wallet-flow
#    Obtén la URL y token: turso db tokens create wallet-flow
#    TURSO_DATABASE_URL="libsql://wallet-flow-tu-usuario.turso.io"
#    TURSO_AUTH_TOKEN="eyJhbGci..."
#
# 3. MODO INTEGRACIÓN TURSO EN VERCEL (Automático):
#    Si conectas Turso a través de Vercel Marketplace / Integraciones, se detectan
#    automáticamente cualquiera de estos nombres:
#    - TURSO_DATABASE_URL o TURSO_DB_URL o DATABASE_URL o LIBSQL_URL
#    - TURSO_AUTH_TOKEN o TURSO_DB_AUTH_TOKEN o DATABASE_AUTH_TOKEN o LIBSQL_AUTH_TOKEN
#
# 4. MODO RÉPLICA EMBEBIDA (Solo para entornos de servidor Node persistente):
#    Lectura ultra-rápida en SQLite local y sincronización automática en la nube de Turso.
#    TURSO_DATABASE_URL="libsql://wallet-flow-tu-usuario.turso.io"
#    TURSO_AUTH_TOKEN="eyJhbGci..."
#    TURSO_EMBEDDED_REPLICA="true"
#
# ==============================================================================

TURSO_DATABASE_URL="file:wallet_flow.db"
TURSO_AUTH_TOKEN=""
TURSO_EMBEDDED_REPLICA="false"

# Aliases compatibles automáticamente
DATABASE_URL="file:wallet_flow.db"
DATABASE_AUTH_TOKEN=""

# ==============================================================================
# Seguridad y sesiones
# ==============================================================================
# Secreto para firmar la cookie de sesión (mínimo 32 caracteres). Recomendado en producción.
# Si se omite, se genera uno aleatorio y se guarda en la base de datos.
# Generar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# "false" deshabilita el registro de nuevos usuarios (por defecto: abierto).
ALLOW_REGISTRATION="true"
